# Twitch channel to read chat from
# Do not include the # symbol
TWITCH_CHANNEL=your_twitch_channel

# Your Speechify API key
SPEECHIFY_API_KEY=your_speechify_api_key

# Speechify model
SPEECHIFY_MODEL=simba-3.2

# Cooldown between accepted Twitch messages (seconds)
COOLDOWN_SECONDS=1

# Maximum Twitch message length sent to Speechify
MAX_MESSAGE_LENGTH=200

# Local web server port
PORT=3000
